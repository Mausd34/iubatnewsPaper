# Copy to .env and adjust for your machine
SECRET_KEY=change-me-in-production-use-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Database: leave DATABASE_URL empty to use SQLite
# PostgreSQL example:
# DATABASE_URL=postgres://user:password@localhost:5432/iubat_news
DATABASE_URL=

# Email (newsletter). Development uses the console backend.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=IUBAT News <news@iubatnews.edu>

# Cloudinary (optional, only if you want cloud media in production)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
